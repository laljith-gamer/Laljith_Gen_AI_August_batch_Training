# ==========================================
# SMART HIRE GENAI - Environment Configuration
# ==========================================

# Google Gemini API Key (Required for LLM and Gemini Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Models
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# Search Configuration
TOP_K_JOBS=5
SIMILARITY_THRESHOLD=0.30

# Chunking Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Persistence Paths
JOB_INDEX_DIR=vectorstore/jobs
MENTOR_INDEX_DIR=vectorstore/mentor
FEEDBACK_DIR=data/feedback
JOBS_DATA_PATH=data/jobs/jobs.csv
CAREER_NOTES_DIR=data/career_notes
